state 0

    0 $accept: . PROGRAM $end

    INT    shift, and go to state 1
    FLOAT  shift, and go to state 2
    ID     shift, and go to state 3

    PROGRAM  go to state 4
    LEXPR    go to state 5
    TYPE     go to state 6


