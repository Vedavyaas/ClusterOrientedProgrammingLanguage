Grammar

    0 $accept: PROGRAM $end

    1 PROGRAM: LEXPR PROGRAM
    2        | LEXPR

    3 LEXPR: ID '=' EXPR ';'
    4      | ID PLUS_EQUAL EXPR ';'
    5      | ID MINUS_EQUAL EXPR ';'
    6      | ID STAR_EQUAL EXPR ';'
    7      | ID DIVISON_EQUAL EXPR ';'
    8      | ID MODULO_EQUAL EXPR ';'
    9      | TYPE ID '=' EXPR ';'
   10      | TYPE IDLIST ';'

   11 EXPR: EXPR '+' EXPR
   12     | EXPR '-' EXPR
   13     | EXPR '*' EXPR
   14     | EXPR '/' EXPR
   15     | EXPR '%' EXPR
   16     | '-' EXPR
   17     | '(' EXPR ')'
   18     | EXPR INCREMENT
   19     | EXPR DECREMENT
   20     | INCREMENT EXPR
   21     | DECREMENT EXPR
   22     | ID
   23     | INTEGER_LITERAL
   24     | FLOAT_LITERAL

   25 IDLIST: ID
   26       | IDLIST ',' ID

   27 TYPE: INT
   28     | FLOAT


